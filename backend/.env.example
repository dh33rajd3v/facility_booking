# Copy to backend/.env and adjust. Never commit the real .env.
APP_ENV=development
# Signs the short-lived sign-in cookie. Any long random string; required outside development.
APP_SECRET_KEY=replace-with-a-long-random-string

# PostgreSQL connection: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# Replace YOUR_PASSWORD with the password you chose for the "postgres" user when installing PostgreSQL.
# If the password contains @ : / % or #, URL-encode it (e.g. @ -> %40).
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/facility_booking
# Used only by pytest. Must end in _test, because the tests wipe it.
TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/facility_booking_test

# Comma-separated list of allowed browser origins. The first is where users land after signing in.
FRONTEND_URL=http://localhost:5173

# --- Google sign-in (Week 2) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorised redirect URI must be exactly the GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
# Accounts with exactly this email domain get the IIT rate automatically.
IIT_EMAIL_DOMAIN=iitrpr.ac.in
# How long a sign-in lasts, in hours (168 = 7 days).
SESSION_TTL_HOURS=168
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false
# Development only: show a "sign in without Google" form for testing. Ignored unless
# APP_ENV is development. Never enable on a shared or deployed server.
DEV_LOGIN_ENABLED=false

# --- Used from Week 4 onwards ---
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=facilities@example.invalid
